rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    
    
    
    
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == "google.com")
        && (request.auth.token.email == "osamaasas0@gmail.com"
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    
    function teacherSubActive(tid) {
      let d = get(/databases/$(database)/documents/teachers/$(tid)).data;
      return d.get("subType", "free") == "free"
        || d.get("subEnd", null) == null
        || request.time <= d.subEnd;
    }
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true
        && teacherSubActive(request.auth.uid);
    }

    
    function currentTerm() {
      return (!exists(/databases/$(database)/documents/settings/app)
          || get(/databases/$(database)/documents/settings/app).data.get("currentTerm", 1) == 1) ? 1 : 2;
    }

    
    function studentData() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }
    
    function studentActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && studentData().get("status", "approved") != "suspended";
    }
    
    function notSuspendedBy(tid) {
      return !(tid in studentData().get("suspendedBy", []));
    }
    
    
    function teacherNotAdminSuspended(tid) {
      let pub = get(/databases/$(database)/documents/teachersPublic/$(tid)).data;
      return !exists(/databases/$(database)/documents/teachersPublic/$(tid))
        || (pub.get("active", true) != false
            && (pub.get("subType", "free") == "free"
                || pub.get("subEnd", null) == null
                || request.time <= pub.subEnd));
    }

    
    
    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() && email != "osamaasas0@gmail.com";
    }

    
    
    match /settings/{docId} {
      allow read: if request.auth != null || docId == "footer" || docId == "stats" || docId == "about";
      allow write: if isAdmin();
    }

    
    match /teachers/{teacherId} {
      allow get: if isAdmin() || request.auth.uid == teacherId;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isTeacher() && request.auth.uid == teacherId
            && request.resource.data.active == resource.data.active
            
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["subType", "subAmount", "subStart", "subEnd"]));
    }

    
    
    match /teachersPublic/{teacherId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      allow update: if isAdmin()
        || (isTeacher() && request.auth.uid == teacherId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["avatar", "courseComplete", "pageBio", "pageOn", "pageStats"])
            && request.resource.data.get("courseComplete", false) is bool
            && request.resource.data.get("pageOn", false) is bool
            && request.resource.data.get("pageBio", "") is string && request.resource.data.get("pageBio", "").size() <= 300
            && request.resource.data.get("pageStats", {}) is map
            && request.resource.data.get("pageStats", {}).keys().hasOnly(["students", "lessons", "quizzes", "at"]));
    }

    
    
    
    
    
    
    match /registrationLookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        || (isTeacher()
            && request.resource.data.keys().hasOnly(["saltEmail", "status", "studentId", "teacherIds", "authLinked", "addedBy"])
            && request.resource.data.saltEmail == lookupId
            && lookupId == lookupId.lower()
            && request.resource.data.status == "approved"
            && request.resource.data.authLinked == true
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.teacherIds == [request.auth.uid]
            && request.resource.data.studentId is string
            && request.resource.data.studentId.size() > 0)
        || (request.resource.data.keys().hasOnly(["pinHash", "saltEmail", "status", "studentId", "teacherIds"])
            && request.resource.data.status == "pending"
            && request.resource.data.pinHash is string
            && request.resource.data.pinHash.size() == 64
            && request.resource.data.saltEmail == lookupId
            && request.resource.data.studentId is string
            && request.resource.data.teacherIds is list
            && request.resource.data.teacherIds.size() > 0
            && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
            && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.status == "pending"
            && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.email == lookupId);
      
      
      
      
      allow update: if isAdmin() || isTeacher()
        || (request.auth != null
            && request.auth.token.email == lookupId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authLinked", "pinHash"])
            && request.resource.data.get("pinHash", "") == "");
      allow delete: if isAdmin() || isTeacher();
    }

    
    
    match /lessons/{lessonId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId)
            && teacherNotAdminSuspended(resource.data.teacherId));
      
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.get("term", 1) == currentTerm());
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid
        && resource.data.get("term", 1) == currentTerm());
    }

    
    
    
    function mediaReader(tid) {
      return isAdmin()
        || (isTeacher() && tid == request.auth.uid)
        || (studentActive()
            && tid in studentData().teacherIds
            && notSuspendedBy(tid)
            && teacherNotAdminSuspended(tid));
    }
    function ownsLesson(lid) {
      return exists(/databases/$(database)/documents/lessons/$(lid))
        && get(/databases/$(database)/documents/lessons/$(lid)).data.teacherId == request.auth.uid;
    }

    match /lessonMedia/{lessonId} {
      allow get: if mediaReader(resource.data.teacherId);
      allow list: if isAdmin();
      allow create, update: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && ownsLesson(lessonId)
        && request.resource.data.keys().hasOnly(["teacherId", "videoUrl", "pdfUrl", "pdfFile", "updatedAt"]);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /lessonFileChunks/{chunkId} {
      allow get: if mediaReader(resource.data.teacherId);
      allow list: if isAdmin();
      allow create, update: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && ownsLesson(request.resource.data.lessonId)
        && request.resource.data.keys().hasOnly(["teacherId", "lessonId", "i", "data"])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.i is int
        && chunkId == request.resource.data.lessonId + "_" + string(request.resource.data.i);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /quizzes/{quizId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId)
            && teacherNotAdminSuspended(resource.data.teacherId));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.get("term", 1) == currentTerm());
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid
        && resource.data.get("term", 1) == currentTerm());
    }

    
    
    match /announcements/{annId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId)
            && teacherNotAdminSuspended(resource.data.teacherId));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    
    match /questionBank/{qId} {
      allow get, list: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    
    match /studentNotes/{noteId} {
      allow get, list: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    
    
    match /exams/{examId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId)
            && teacherNotAdminSuspended(resource.data.teacherId));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.get("term", 1) == currentTerm());
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid
        && resource.data.get("term", 1) == currentTerm());
    }

    
    
    match /quizAttempts/{attemptId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && request.auth.uid == resource.data.studentId);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.studentId
        && studentActive()
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId);
      
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    
    
    
    match /lessonRatings/{ratingId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && request.auth.uid == resource.data.studentId);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.studentId
        && ratingId == request.auth.uid + "_" + request.resource.data.lessonId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && studentActive()
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId);
      
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    
    // الحصص المباشرة (جديد): المدرس بيضيف لينك Zoom/Meet وميعاد، وطلابه بيقروا
    match /liveClasses/{liveId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId)
            && teacherNotAdminSuspended(resource.data.teacherId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherId', 'title', 'url', 'startsAt', 'grade', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
        && request.resource.data.url is string && request.resource.data.url.matches('^https://.*') && request.resource.data.url.size() <= 300
        && request.resource.data.startsAt is timestamp
        && request.resource.data.get('grade', '') is string;
      allow update: if false;
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // لوحة شرف الكويزات (جديد): كل طالب بيكتب مستنده هو بس (اسمه الأول ومتوسطه)، وطلاب نفس المدرس بيقروا
    match /quizBoard/{entryId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId));
      allow create, update: if studentActive()
        && request.auth.uid == request.resource.data.studentId
        && entryId == request.auth.uid + '_' + request.resource.data.teacherId
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId)
        && request.resource.data.keys().hasOnly(['teacherId', 'studentId', 'name', 'grade', 'sum', 'count', 'avg', 'hidden', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 60
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 10000
        && request.resource.data.avg is number && request.resource.data.avg >= 0 && request.resource.data.avg <= 100
        && request.resource.data.sum is number && request.resource.data.sum >= 0 && request.resource.data.sum <= 1000000
        && request.resource.data.hidden is bool;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.studentId);
    }

    // أكواد التجربة والخصم (جديد): الأدمن بس
    match /promoCodes/{code} {
      allow get, list, create, update, delete: if isAdmin();
    }


    // نشاط الدروس (جديد، تتبّع الفيديو والـ PDF): الطالب بيكتب مستند واحد لكل درس باسمه، والمدرس بيقرا مستندات دروسه
    match /videoWatch/{wid} {
      allow get, list: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, update: if studentActive()
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 40
        && wid == request.auth.uid + '_' + request.resource.data.lessonId
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId)
        && get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.teacherId == request.resource.data.teacherId
        && request.resource.data.keys().hasOnly(['lessonId', 'teacherId', 'studentId', 'stops', 'rewinds', 'openedAt', 'playedAt', 'finishedAt', 'pdfAt', 'pct', 'updatedAt'])
        && request.resource.data.get('stops', {}) is map && request.resource.data.get('stops', {}).size() <= 240
        && request.resource.data.get('rewinds', {}) is map && request.resource.data.get('rewinds', {}).size() <= 240
        && request.resource.data.get('openedAt', 0) is number && request.resource.data.get('playedAt', 0) is number
        && request.resource.data.get('finishedAt', 0) is number && request.resource.data.get('pdfAt', 0) is number
        && request.resource.data.get('pct', 0) is number && request.resource.data.get('pct', 0) <= 100
        && request.resource.data.updatedAt is number;
      allow delete: if isAdmin();
    }

    // تقييمات المدرسين (جديد): المعتمد بس (approved) مقروء للكل، والطالب بيكتب تقييمه بعد ما المدرس يعلن اكتمال الكورس، والأدمن بيوافق
    function reviewShapeOk() {
      return request.resource.data.keys().hasOnly(['teacherId', 'studentId', 'studentName', 'stars', 'text', 'status', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 30
        && request.resource.data.updatedAt is number;
    }
    match /teacherReviews/{rid} {
      allow get: if request.auth != null && (resource == null || resource.data.status == 'approved' || isAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if resource.data.status == 'approved'
        || isAdmin()
        || (request.auth != null && resource.data.studentId == request.auth.uid);
      allow create: if studentActive()
        && request.auth.uid == request.resource.data.studentId
        && rid == request.auth.uid + '_' + request.resource.data.teacherId
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId)
        && exists(/databases/$(database)/documents/teachersPublic/$(request.resource.data.teacherId))
        && get(/databases/$(database)/documents/teachersPublic/$(request.resource.data.teacherId)).data.get('courseComplete', false) == true
        && reviewShapeOk();
      allow update: if isAdmin()
        || (studentActive()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.teacherId == resource.data.teacherId
            && reviewShapeOk());
      allow delete: if isAdmin() || (request.auth != null && resource.data.studentId == request.auth.uid);
    }

    // وضع ولي الأمر (جديد): لقطة تقدّم بكود عشوائي طويل. القراءة بالكود بس (get)، من غير list. الكتابة للطالب صاحبها
    function parentShapeOk() {
      return request.resource.data.keys().hasOnly(['studentId', 'name', 'grade', 'stats', 'weak', 'recent', 'updatedAt'])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 60
        && request.resource.data.stats is map
        && request.resource.data.weak is list && request.resource.data.weak.size() <= 3
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 5
        && request.resource.data.updatedAt is number;
    }
    match /parentViews/{code} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.studentId == request.auth.uid);
      allow create: if studentActive() && code.size() >= 20 && code.size() <= 40 && parentShapeOk();
      allow update: if studentActive() && resource.data.studentId == request.auth.uid && parentShapeOk();
      allow delete: if isAdmin() || (request.auth != null && resource.data.studentId == request.auth.uid);
    }

    // حالة المستخدم عبر الأجهزة (جديد): كل مستخدم (طالب/مدرس/أدمن) بيقرا ويكتب مستنده هو بس
    function userStateOk() {
      return request.resource.data.keys().hasOnly(['v', 'at', 'updatedAt'])
        && request.resource.data.v is map
        && request.resource.data.v.keys().hasOnly(['srs', 'boardHidden', 'secState', 'recipientMode', 'bulkDone', 'backupLast', 'backupSnooze', 'parentCode', 'watched', 'lang'])
        && request.resource.data.v.get('srs', '').size() <= 30000
        && request.resource.data.v.get('bulkDone', '').size() <= 30000
        && request.resource.data.v.get('secState', '').size() <= 3000
        && request.resource.data.v.get('boardHidden', '').size() <= 10
        && request.resource.data.v.get('recipientMode', '').size() <= 30
        && request.resource.data.v.get('backupLast', '').size() <= 20
        && request.resource.data.v.get('backupSnooze', '').size() <= 20
        && request.resource.data.v.get('parentCode', '').size() <= 50
        && request.resource.data.v.get('watched', '').size() <= 30000
        && request.resource.data.v.get('lang', '').size() <= 20
        && request.resource.data.at is map
        && request.resource.data.updatedAt is number;
    }
    match /userState/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && userStateOk();
    }

    // تواصل الطلاب مع المدرس (جديد): رقم واتساب ولينك جروب. المدرس بيكتب مستنده، وطلابه المسجلين عنده بس بيقروا
    match /teacherContact/{tid} {
      allow get: if isAdmin()
        || (isTeacher() && request.auth.uid == tid)
        || (studentActive() && tid in studentData().teacherIds && notSuspendedBy(tid));
      allow create, update: if isTeacher() && request.auth.uid == tid
        && request.resource.data.keys().hasOnly(['phone', 'groupLink', 'on', 'updatedAt'])
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
        && request.resource.data.groupLink is string && request.resource.data.groupLink.size() <= 200
        && (request.resource.data.groupLink == '' || request.resource.data.groupLink.matches('^https://(chat[.]whatsapp[.]com|wa[.]me|t[.]me|telegram[.]me|telegram[.]dog)/.+'))
        && request.resource.data.on is bool
        && request.resource.data.updatedAt is number;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == tid);
    }

    // أسئلة وتعليقات الدروس (جديد): طلاب نفس المدرس بيقروا، الطالب بيكتب باسمه ويحذف بتاعه، المدرس بيرد ويحذف
    match /lessonComments/{commentId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (studentActive()
            && resource.data.teacherId in studentData().teacherIds
            && notSuspendedBy(resource.data.teacherId));
      allow create: if studentActive()
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId)
        && request.resource.data.keys().hasOnly(['lessonId', 'teacherId', 'studentId', 'studentName', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt'])
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 1000;
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && request.auth.uid == resource.data.studentId);
    }

    match /library/{docId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    
    match /subjects/{subjectId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    
    // طالب بيضيفه المدرس بنفسه (إضافة طالب / رفع قايمة): معتمد ومربوط بالمدرس ده بس، وبحقول معروفة بس
    function teacherAddsStudent() {
      let d = request.resource.data;
      return isTeacher()
        && d.keys().hasOnly(["name", "email", "grade", "phone", "parentPhone", "teacherIds", "status", "authLinked", "addedBy", "createdAt"])
        && d.keys().hasAll(["name", "email", "grade", "teacherIds", "status", "authLinked", "addedBy", "createdAt"])
        && d.status == "approved"
        && d.authLinked == true
        && d.addedBy == request.auth.uid
        && d.teacherIds == [request.auth.uid]
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') && d.email == d.email.lower()
        && d.grade is string && d.grade.size() <= 40
        && d.get("phone", "") is string && d.get("phone", "").size() <= 15
        && d.get("parentPhone", "") is string && d.get("parentPhone", "").size() <= 15
        && d.createdAt == request.time;
    }

    match /students/{studentId} {
      
      
      
      
      allow get: if isAdmin()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds)
        || (request.auth != null && request.auth.uid == studentId)
        || (request.auth != null && request.auth.token.email == resource.data.email
            && resource.data.get("authLinked", false) != true);
      
      
      
      allow list: if isAdmin()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds);
      
      
      
      
      allow create: if isAdmin() || teacherAddsStudent()
        || request.resource.data.status == "pending"
        || (request.auth != null && request.auth.uid == studentId
            && request.resource.data.email == request.auth.token.email
            && get(/databases/$(database)/documents/registrationLookup/$(request.auth.token.email)).data.status == "approved"
            && request.resource.data.status == "approved"
            && request.resource.data.teacherIds == get(/databases/$(database)/documents/registrationLookup/$(request.auth.token.email)).data.teacherIds);
      
      allow update: if isAdmin()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds)
        || (isTeacher() && !(request.auth.uid in resource.data.teacherIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["teacherIds"])
            && request.resource.data.teacherIds.toSet() == resource.data.teacherIds.toSet().union([request.auth.uid].toSet())
            && exists(/databases/$(database)/documents/teacherRequests/$(studentId + "_" + request.auth.uid))
            && get(/databases/$(database)/documents/teacherRequests/$(studentId + "_" + request.auth.uid)).data.status == "pending")
        || (request.auth != null && request.auth.uid == studentId
            && request.resource.data.status == resource.data.status
            && request.resource.data.email == resource.data.email
            && request.resource.data.teacherIds == resource.data.teacherIds);
      
      
      allow delete: if isAdmin()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds)
        || (request.auth != null && request.auth.token.email == resource.data.email
            && resource.data.get("authLinked", false) != true);
    }

    
    /* طلبات تسجيل المدرسين: أي حد (من غير دخول) يقدر يبعت طلب واحد بإيميله، والأدمن بس يقرا ويقبل ويرفض ويمسح */
    match /teacherSignups/{signupId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "phone", "subject", "grades", "stages", "bio", "promo", "status", "createdAt"])
        && request.resource.data.keys().hasAll(["name", "email", "phone", "subject", "grades", "stages", "status", "createdAt"])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && signupId == request.resource.data.email
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.subject is string && request.resource.data.subject.size() >= 1 && request.resource.data.subject.size() <= 60
        && request.resource.data.grades is list && request.resource.data.grades.size() >= 1 && request.resource.data.grades.size() <= 12
        && request.resource.data.stages is list && request.resource.data.stages.size() <= 3
        && request.resource.data.get("bio", "") is string && request.resource.data.get("bio", "").size() <= 300
        && request.resource.data.get("promo", "") is string && request.resource.data.get("promo", "").size() <= 20
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
    }

    match /teacherRequests/{reqId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && resource.data.studentId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["studentId", "teacherId", "studentName", "grade", "email", "status", "createdAt"])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && reqId == request.auth.uid + "_" + request.resource.data.teacherId
        && request.resource.data.status == "pending"
        && request.resource.data.studentName is string
        && request.resource.data.teacherId is string
        && studentActive()
        && studentData().get("status", "approved") == "approved"
        && !(request.resource.data.teacherId in studentData().teacherIds)
        && exists(/databases/$(database)/documents/teachersPublic/$(request.resource.data.teacherId))
        && get(/databases/$(database)/documents/teachersPublic/$(request.resource.data.teacherId)).data.get("active", true) != false;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["accepted", "rejected"];
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && resource.data.studentId == request.auth.uid);
    }

    match /subscriptionPayments/{paymentId} {
      allow read, write: if isAdmin();
    }

    
    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    
    
    
    
    match /activityLog/{entryId} {
      allow get, list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (request.auth != null && studentActive()
            && resource.data.teacherId in studentData().teacherIds);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.studentId
        && studentActive()
        && request.resource.data.teacherId in studentData().teacherIds
        && notSuspendedBy(request.resource.data.teacherId)
        && request.resource.data.points in [10, 20]
        && request.resource.data.kind in ["lesson", "quiz"];
      allow update, delete: if false;
    }

    
    match /broadcasts/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
